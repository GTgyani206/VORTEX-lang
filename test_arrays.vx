// Test array functionality
print("=== Array Tests ===")

// Create an array
let numbers = [1, 2, 3, 4, 5]
print("Array:")
print(numbers)

// Test array indexing
print("First element:")
print(numbers[0])

print("Third element:")
print(numbers[2])

print("Last element:")
print(numbers[4])

// Mixed type array
let mixed = [1, 3.14, "hello", true]
print("Mixed array:")
print(mixed)

print("String element:")
print(mixed[2])

print("Boolean element:")
print(mixed[3])

// Empty array
let empty = []
print("Empty array:")
print(empty)

print("=== Array Tests Complete ===")